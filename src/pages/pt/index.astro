---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getPostsByLang from "@/utils/getPostsByLang";
import IconRss from "@/assets/icons/IconRss.svg";
import { SITE } from "@/config";

const allPosts = await getCollection("blog");
const posts = getPostsByLang(allPosts, "pt");
const sortedPosts = getSortedPosts(posts);
---

<Layout
  title={`Blog | ${SITE.title}`}
  description="Notas de engenharia, segurança e operação do time por trás da EntryTarget."
>
  <Header lang="pt" />
  <main id="main-content" data-layout="index" class="editorial-layout">
    <section class="idx-hero">
      <span class="kicker">EntryTarget · Diário</span>
      <h1 class="idx-h1">
        Notas sobre infra<br />de ledger double-entry.
      </h1>
      <p class="idx-dek">
        Engenharia, segurança e operação — escritos do time que constrói a
        EntryTarget. Posts saem quando temos algo real pra dizer, não em
        cadência fixa.
      </p>
      <div class="idx-hero-links">
        <a class="idx-link" href="/rss.xml">
          <IconRss class="idx-rss-icon" /> Feed RSS
        </a>
        <a class="idx-link" href="https://entrytarget.com/">entrytarget.com ↗</a>
      </div>
    </section>

    {
      sortedPosts.length > 0 && (
        <section class="idx-grid">
          {sortedPosts.map(post => (
            <Card {...post} />
          ))}
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/pt/");
    }
  });
</script>

<style>
  .idx-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }
  .idx-hero .kicker {
    display: inline-block;
    margin-bottom: 1.25rem;
  }
  .idx-h1 {
    font-family: var(--font-serif), Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 900px;
  }
  .idx-dek {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 680px;
    margin-top: 2rem;
  }
  .idx-hero-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .idx-link {
    font-family: var(--font-mono), monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .idx-link:hover {
    color: var(--muted);
  }
  :global(.idx-rss-icon) {
    width: 0.85rem;
    height: 0.85rem;
    stroke: currentColor;
    stroke-width: 2.5;
  }
  .idx-grid {
    display: grid;
    grid-template-columns: 1fr;
    margin: 4rem 0 7rem;
    border-top: 1px solid var(--rule);
    list-style: none;
    padding: 0;
  }
  .idx-grid :global(.ed-card) {
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 720px) {
    .idx-grid {
      grid-template-columns: 1fr 1fr;
    }
    .idx-grid :global(.ed-card:nth-child(odd)) {
      border-right: 1px solid var(--rule);
    }
  }
</style>
