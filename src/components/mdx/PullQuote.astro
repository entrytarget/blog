---
/**
 * PullQuote — serif block quote with an accent-coloured quote mark.
 *
 * Usage:
 *   <PullQuote attr="Fintech engineering lead, anon.">
 *     We picked the model that pushes the compliance questions back onto us.
 *   </PullQuote>
 */
interface Props {
  attr?: string;
}

const { attr } = Astro.props;
---

<figure class="quote">
  <blockquote class="q"><slot /></blockquote>
  {attr && <figcaption class="attr">— {attr}</figcaption>}
</figure>

<style>
  .quote {
    margin: 3.5rem 0;
    padding: 0;
  }

  .q {
    font-family: var(--font-serif), Georgia, serif;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--foreground);
    margin: 0 0 1rem;
  }

  .q::before {
    content: "\201C";
    color: var(--accent);
    margin-right: 0.25rem;
  }

  .attr {
    font-family: var(--font-mono), monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
